create or replace  temporary view DOORDASH.marts.fact_order_items__dbt_tmp
  
   as (
    
select
    oi.order_item_id,
    oi.order_id,
    oi.restaurant_id,
    oi.f_id,
    o.order_timestamp as order_ts,
    o.order_date,
